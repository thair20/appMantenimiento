<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_image"
    tools:context=".MainActivity">

    <!-- Cabecera con Bordes Redondeados y Translúcida -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="12dp"
        android:background="@drawable/border_header"
        android:gravity="center"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💥 SISTEMA DE PROFORMAS PRO 💥"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tarjeta Principal con Fondo Translúcido y Borde Rojo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/border_card"
                android:padding="16dp"
                android:layout_marginBottom="14dp"
                android:elevation="6dp">

                <!-- Código del Producto con validación maxLength -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Código del Producto"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="10dp"
                    app:boxStrokeColor="#EF4444"
                    app:hintTextColor="#EF4444"
                    android:textColorHint="#F1F5F9">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtcodigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="6"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Descripción del Producto con validación maxLength -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Descripción del Producto"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="10dp"
                    app:boxStrokeColor="#EF4444"
                    app:hintTextColor="#EF4444"
                    android:textColorHint="#F1F5F9">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtProducto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="40"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Precio (S/.)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginEnd="6dp"
                        app:boxStrokeColor="#EF4444"
                        app:hintTextColor="#EF4444"
                        android:textColorHint="#F1F5F9">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtPrecio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textSize="15sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Cantidad"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginStart="6dp"
                        app:boxStrokeColor="#EF4444"
                        app:hintTextColor="#EF4444"
                        android:textColorHint="#F1F5F9">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtCantidad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textSize="15sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Panel de Total Translúcido -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#660F172A"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL A PAGAR:"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FCA5A5"/>

                    <TextView
                        android:id="@+id/txtResultado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="S/. 0.00"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:textColor="#FACC15"/>
                </LinearLayout>

                <!-- Botones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnNuevo"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="NUEVO"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:backgroundTint="#475569"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="2dp"
                        android:layout_marginEnd="2dp"/>

                    <Button
                        android:id="@+id/btnGrabar"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="GRABAR"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:backgroundTint="#D32F2F"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="2dp"
                        android:layout_marginHorizontal="2dp"/>

                    <Button
                        android:id="@+id/btnEditar"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="ACTUAL"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:backgroundTint="#1D4ED8"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="2dp"
                        android:layout_marginHorizontal="2dp"/>

                    <Button
                        android:id="@+id/btnEliminar"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="BORRAR"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:backgroundTint="#B91C1C"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="2dp"
                        android:layout_marginStart="2dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Contenedor de la Lista Inferior -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@drawable/border_card"
                android:padding="8dp"
                android:elevation="6dp"
                android:layout_marginBottom="12dp">

                <ListView
                    android:id="@+id/ListProforma"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="#EF4444"
                    android:dividerHeight="3dp"
                    android:scrollbars="vertical"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>